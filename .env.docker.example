# FastAPI backend
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword

# MQTT
MQTT_BROKER_HOST=mqtt-broker
MQTT_BROKER_PORT=1883
MQTT_TOPIC=notifications.created
MQTT_USERNAME=
MQTT_PASSWORD=

# Audit / validator
AUDIT_VALIDATOR_URL=http://audit-validator:8001
AUDIT_CHAIN_PATH=/app/data/audit_chain.json
AUDIT_PENDING_PATH=/app/data/pending_audit_events.json
AUDIT_TX_SIGNING_SECRET=tx-secret-dev
AUDIT_BLOCK_SIGNING_SECRET=block-secret-dev
